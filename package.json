{
  "name": "lanka-validations",
  "version": "2.1.0",
  "description": "High-performance, zero-dependency Sri Lankan data validation library for TypeScript and JavaScript. Validate and parse Sri Lankan National Identity Card (NIC), phone numbers, passport, driving license, vehicle number plates, LKR currency, date of birth (DOB), gender, postal codes, CBSL bank codes, and TIN.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "nic": [
        "./dist/nic/index.d.ts"
      ],
      "phone": [
        "./dist/phone/index.d.ts"
      ],
      "passport": [
        "./dist/passport/index.d.ts"
      ],
      "license": [
        "./dist/license/index.d.ts"
      ],
      "vehicle": [
        "./dist/vehicle/index.d.ts"
      ],
      "currency": [
        "./dist/currency/index.d.ts"
      ],
      "dob": [
        "./dist/dob/index.d.ts"
      ],
      "gender": [
        "./dist/gender/index.d.ts"
      ],
      "postal-code": [
        "./dist/postal-code/index.d.ts"
      ],
      "bank": [
        "./dist/bank/index.d.ts"
      ],
      "tax": [
        "./dist/tax/index.d.ts"
      ],
      "administrative": [
        "./dist/administrative/index.d.ts"
      ],
      "schema": [
        "./dist/schema/index.d.ts"
      ],
      "privacy": [
        "./dist/privacy/index.d.ts"
      ],
      "i18n": [
        "./dist/i18n/index.d.ts"
      ],
      "reference-data": [
        "./dist/reference-data/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nic": {
      "import": {
        "types": "./dist/nic/index.d.mts",
        "default": "./dist/nic/index.mjs"
      },
      "require": {
        "types": "./dist/nic/index.d.ts",
        "default": "./dist/nic/index.js"
      }
    },
    "./phone": {
      "import": {
        "types": "./dist/phone/index.d.mts",
        "default": "./dist/phone/index.mjs"
      },
      "require": {
        "types": "./dist/phone/index.d.ts",
        "default": "./dist/phone/index.js"
      }
    },
    "./passport": {
      "import": {
        "types": "./dist/passport/index.d.mts",
        "default": "./dist/passport/index.mjs"
      },
      "require": {
        "types": "./dist/passport/index.d.ts",
        "default": "./dist/passport/index.js"
      }
    },
    "./license": {
      "import": {
        "types": "./dist/license/index.d.mts",
        "default": "./dist/license/index.mjs"
      },
      "require": {
        "types": "./dist/license/index.d.ts",
        "default": "./dist/license/index.js"
      }
    },
    "./vehicle": {
      "import": {
        "types": "./dist/vehicle/index.d.mts",
        "default": "./dist/vehicle/index.mjs"
      },
      "require": {
        "types": "./dist/vehicle/index.d.ts",
        "default": "./dist/vehicle/index.js"
      }
    },
    "./currency": {
      "import": {
        "types": "./dist/currency/index.d.mts",
        "default": "./dist/currency/index.mjs"
      },
      "require": {
        "types": "./dist/currency/index.d.ts",
        "default": "./dist/currency/index.js"
      }
    },
    "./dob": {
      "import": {
        "types": "./dist/dob/index.d.mts",
        "default": "./dist/dob/index.mjs"
      },
      "require": {
        "types": "./dist/dob/index.d.ts",
        "default": "./dist/dob/index.js"
      }
    },
    "./gender": {
      "import": {
        "types": "./dist/gender/index.d.mts",
        "default": "./dist/gender/index.mjs"
      },
      "require": {
        "types": "./dist/gender/index.d.ts",
        "default": "./dist/gender/index.js"
      }
    },
    "./postal-code": {
      "import": {
        "types": "./dist/postal-code/index.d.mts",
        "default": "./dist/postal-code/index.mjs"
      },
      "require": {
        "types": "./dist/postal-code/index.d.ts",
        "default": "./dist/postal-code/index.js"
      }
    },
    "./bank": {
      "import": {
        "types": "./dist/bank/index.d.mts",
        "default": "./dist/bank/index.mjs"
      },
      "require": {
        "types": "./dist/bank/index.d.ts",
        "default": "./dist/bank/index.js"
      }
    },
    "./tax": {
      "import": {
        "types": "./dist/tax/index.d.mts",
        "default": "./dist/tax/index.mjs"
      },
      "require": {
        "types": "./dist/tax/index.d.ts",
        "default": "./dist/tax/index.js"
      }
    },
    "./administrative": {
      "import": {
        "types": "./dist/administrative/index.d.mts",
        "default": "./dist/administrative/index.mjs"
      },
      "require": {
        "types": "./dist/administrative/index.d.ts",
        "default": "./dist/administrative/index.js"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.mts",
        "default": "./dist/schema/index.mjs"
      },
      "require": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      }
    },
    "./privacy": {
      "import": {
        "types": "./dist/privacy/index.d.mts",
        "default": "./dist/privacy/index.mjs"
      },
      "require": {
        "types": "./dist/privacy/index.d.ts",
        "default": "./dist/privacy/index.js"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n/index.d.mts",
        "default": "./dist/i18n/index.mjs"
      },
      "require": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n/index.js"
      }
    },
    "./reference-data": {
      "import": {
        "types": "./dist/reference-data/index.d.mts",
        "default": "./dist/reference-data/index.mjs"
      },
      "require": {
        "types": "./dist/reference-data/index.d.ts",
        "default": "./dist/reference-data/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:package": "npm run build && publint --strict && attw --pack .",
    "size": "npm run build && size-limit",
    "docs": "typedoc && node scripts/build-llms.mjs",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:coverage && npm run lint:package && node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmsalmanfaris/lanka-validations.git"
  },
  "bugs": {
    "url": "https://github.com/mmsalmanfaris/lanka-validations/issues"
  },
  "homepage": "https://mmsalmanfaris.github.io/lanka-validations/",
  "keywords": [
    "sri-lanka",
    "validation",
    "validator",
    "nic",
    "sri-lankan-nic",
    "nic-validator",
    "national-identity-card",
    "phone-validator",
    "sri-lanka-phone",
    "passport-validator",
    "driving-license",
    "vehicle-plates",
    "number-plate",
    "lkr",
    "sri-lankan-rupee",
    "currency",
    "number-to-words",
    "dob",
    "gender",
    "postal-code",
    "cbsl",
    "bank-codes",
    "tin",
    "vat",
    "kyc",
    "form-validation",
    "sinhala",
    "tamil",
    "typescript",
    "zero-dependency",
    "nic-to-dob",
    "nic-converter",
    "sri-lanka-mobile-number",
    "lkr-to-words",
    "react-hook-form",
    "zod"
  ],
  "author": "M.M. Salman Faris <mmsalmanfaris@outlook.com>",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^8.3.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
