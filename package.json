{
  "name": "lanka-validations",
  "version": "1.0.0",
  "description": "High-performance, zero-dependency Sri Lankan data validation library for TypeScript and JavaScript. Validate and parse Sri Lankan National Identity Card (NIC), phone numbers, passport, driving license, vehicle number plates, LKR currency, date of birth (DOB), gender, postal codes, CBSL bank codes, and TIN.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./nic": {
      "types": "./dist/nic/index.d.ts",
      "import": "./dist/nic/index.mjs",
      "require": "./dist/nic/index.js"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "import": "./dist/phone/index.mjs",
      "require": "./dist/phone/index.js"
    },
    "./passport": {
      "types": "./dist/passport/index.d.ts",
      "import": "./dist/passport/index.mjs",
      "require": "./dist/passport/index.js"
    },
    "./license": {
      "types": "./dist/license/index.d.ts",
      "import": "./dist/license/index.mjs",
      "require": "./dist/license/index.js"
    },
    "./vehicle": {
      "types": "./dist/vehicle/index.d.ts",
      "import": "./dist/vehicle/index.mjs",
      "require": "./dist/vehicle/index.js"
    },
    "./currency": {
      "types": "./dist/currency/index.d.ts",
      "import": "./dist/currency/index.mjs",
      "require": "./dist/currency/index.js"
    },
    "./dob": {
      "types": "./dist/dob/index.d.ts",
      "import": "./dist/dob/index.mjs",
      "require": "./dist/dob/index.js"
    },
    "./gender": {
      "types": "./dist/gender/index.d.ts",
      "import": "./dist/gender/index.mjs",
      "require": "./dist/gender/index.js"
    },
    "./postal-code": {
      "types": "./dist/postal-code/index.d.ts",
      "import": "./dist/postal-code/index.mjs",
      "require": "./dist/postal-code/index.js"
    },
    "./bank": {
      "types": "./dist/bank/index.d.ts",
      "import": "./dist/bank/index.mjs",
      "require": "./dist/bank/index.js"
    },
    "./tax": {
      "types": "./dist/tax/index.d.ts",
      "import": "./dist/tax/index.mjs",
      "require": "./dist/tax/index.js"
    },
    "./administrative": {
      "types": "./dist/administrative/index.d.ts",
      "import": "./dist/administrative/index.mjs",
      "require": "./dist/administrative/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "require": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmsalmanfaris/lanka-validations.git"
  },
  "bugs": {
    "url": "https://github.com/mmsalmanfaris/lanka-validations/issues"
  },
  "homepage": "https://github.com/mmsalmanfaris/lanka-validations#readme",
  "keywords": [
    "sri-lanka",
    "validation",
    "validator",
    "nic",
    "sri-lankan-nic",
    "nic-validator",
    "national-identity-card",
    "phone-validator",
    "sri-lanka-phone",
    "passport-validator",
    "driving-license",
    "vehicle-plates",
    "number-plate",
    "lkr",
    "sri-lankan-rupee",
    "currency",
    "number-to-words",
    "dob",
    "gender",
    "postal-code",
    "cbsl",
    "bank-codes",
    "tin",
    "vat",
    "kyc",
    "form-validation",
    "sinhala",
    "tamil",
    "typescript",
    "zero-dependency"
  ],
  "author": "M.M. Salman Faris <mmsalmanfaris@outlook.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
