{
  "$schema": "https://typedoc.org/schema.json",
  "name": "lanka-validations",
  "entryPoints": [
    "src/index.ts",
    "src/nic/index.ts",
    "src/phone/index.ts",
    "src/passport/index.ts",
    "src/license/index.ts",
    "src/vehicle/index.ts",
    "src/currency/index.ts",
    "src/dob/index.ts",
    "src/gender/index.ts",
    "src/postal-code/index.ts",
    "src/bank/index.ts",
    "src/tax/index.ts",
    "src/administrative/index.ts",
    "src/schema/index.ts",
    "src/privacy/index.ts",
    "src/i18n/index.ts",
    "src/reference-data/index.ts"
  ],
  "out": "api-docs",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "sourceLinkTemplate": "https://github.com/mmsalmanfaris/lanka-validations/blob/main/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": ["Function", "Class", "Interface", "TypeAlias", "Variable"],
  "intentionallyNotExported": ["RuleData", "SchemaResultBase"],
  "treatWarningsAsErrors": true
}
